{
  "name": "Email Notification Workflow",
  "nodes": [
    {
      "parameters": {
        "path": "email-notification",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-notification",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "fromEmail": "notifications@insurance.ai",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject || 'Insurance Notification' }}",
        "text": "={{ $json.message || 'No message provided' }}",
        "html": "={{ '<h1>Insurance Notification</h1><p>' + ($json.message || 'No message provided') + '</p>' }}",
        "options": {}
      },
      "id": "send-notification",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "responseBody": "{\"status\":\"sent\",\"to\":\"{{ $json.to }}\"}"
      },
      "id": "response-notification",
      "name": "Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [650, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{"node": "Send Email", "type": "main", "index": 0}]]
    },
    "Send Email": {
      "main": [[{"node": "Response", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}